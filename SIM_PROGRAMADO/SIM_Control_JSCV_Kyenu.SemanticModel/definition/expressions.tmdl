expression SIM_OperationalRoot = "" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

expression SIM_LoadCSV =
        (FileName as text, ColumnTypes as list, UniqueKeys as list) as table =>
        let
            Names = List.Transform(ColumnTypes, each _{0}),
            Raw = if Text.Trim(SIM_OperationalRoot) = "" then #table(Names, {})
                  else Table.PromoteHeaders(Csv.Document(File.Contents(SIM_OperationalRoot & "\" & FileName), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
            Selected = Table.SelectColumns(Raw, Names, MissingField.Error),
            Typed = Table.TransformColumnTypes(Selected, ColumnTypes, "en-US"),
            RequiredValue = if FileName = "Contracts.csv" then "Contract Value" else if FileName = "PaymentPlan.csv" then "Expected Amount" else if FileName = "Collections.csv" then "Amount" else if FileName = "ProjectMetrics.csv" then "Value" else null,
            NonEmptyValues = if RequiredValue <> null and Table.RowCount(Table.SelectRows(Typed, (row) => Record.Field(row, RequiredValue) = null)) > 0 then error Error.Record("MissingAmount", FileName, RequiredValue) else Typed,
            ValidCompanies = if List.Contains(Names,"Company ID") and Table.RowCount(Table.SelectRows(NonEmptyValues, (row) => not List.Contains({"JSCV","KYENU"}, Record.Field(row,"Company ID")))) > 0 then error Error.Record("InvalidCompany", FileName, null) else NonEmptyValues,
            PeriodChecked = if List.Contains(Names,"Period Date") and Table.RowCount(Table.SelectRows(ValidCompanies, (row) => Record.Field(row,"Period Date") = null or Date.EndOfMonth(Record.Field(row,"Period Date")) <> Record.Field(row,"Period Date"))) > 0 then error Error.Record("InvalidMonthlyPeriod", FileName, "Use month-end dates") else ValidCompanies,
            EntityChecked = if List.Contains(Names,"Entity Key") and Table.RowCount(Table.SelectRows(PeriodChecked, (row) => not List.Contains({"JSCV","KYENU","CON"},Record.Field(row,"Entity Key")))) > 0 then error Error.Record("InvalidReportingEntity",FileName,null) else PeriodChecked,
            NonEmptyKeys = if Table.RowCount(Table.SelectRows(EntityChecked, (row) => List.AnyTrue(List.Transform(if FileName = "KPIPlans.csv" then List.RemoveItems(UniqueKeys, {"Project ID"}) else UniqueKeys, (k) => Record.Field(row,k) = null or Text.Trim(Text.From(Record.Field(row,k))) = "")))) > 0 then error Error.Record("MissingKey", FileName, UniqueKeys) else EntityChecked,
            Valid = if Table.RowCount(Table.Distinct(NonEmptyKeys,UniqueKeys)) <> Table.RowCount(NonEmptyKeys) then error Error.Record("DuplicateKey", FileName, UniqueKeys) else NonEmptyKeys
        in Valid
