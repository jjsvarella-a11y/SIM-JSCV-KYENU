	column 'Actual Collection Date'
		dataType: dateTime
		lineageTag: 43e34865-6f32-504b-a301-8ff2c9902996
		summarizeBy: none
		sourceColumn: Actual Collection Date
		formatString: yyyy-MM-dd

	column 'Amount'
		dataType: double
		lineageTag: b69fc02a-0f70-5105-8a88-1cea44c2133e
		summarizeBy: none
		sourceColumn: Amount

	column 'Currency'
		dataType: string
		lineageTag: e0225145-3bff-547c-acac-848800e259f1
