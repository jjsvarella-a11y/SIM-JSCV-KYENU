table 'Fact_Collections'
	lineageTag: 0a32d48b-9152-5c82-90e9-1b8a74a1e68e

	column 'Collection ID'
		dataType: string
		lineageTag: 048fa539-6e32-5d4c-a4dd-172d894d6c70
