	column 'Project ID'
		dataType: string
		lineageTag: cfb04f1f-4c5c-5132-b6c2-a11068a508e3
		summarizeBy: none
		sourceColumn: Project ID

	column 'Client ID'
		dataType: string
		lineageTag: 4b5121b3-8fa2-592d-8f18-0f65d5089914
