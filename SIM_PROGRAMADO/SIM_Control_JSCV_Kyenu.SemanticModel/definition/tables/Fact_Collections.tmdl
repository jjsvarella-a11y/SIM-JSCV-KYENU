	column 'Unit ID'
		dataType: string
		lineageTag: 7261ebb1-4dbf-5619-8278-735af2c1da39
		summarizeBy: none
		sourceColumn: Unit ID

	partition 'Fact_Collections' = m
		mode: import
		source =
				let
				    Input = (let
				    Raw = SIM_LoadCSV("Collections.csv", {{"Collection ID", type text}, {"Contract ID", type text}, {"Plan ID", type text}, {"Actual Collection Date", type date}, {"Amount", type number}, {"Currency", type text}, {"Status", type text}}, {"Collection ID"}),
				    Joined = Table.NestedJoin(Raw, {"Contract ID"}, Fact_SalesContracts, {"Contract ID"}, "Contract", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined,"Contract",{"Company ID","Project ID","Client ID","Unit ID"}),
				    Valid = if Table.RowCount(Table.SelectRows(Expanded, each [Company ID] = null or [Project ID] = null)) > 0 then error Error.Record("ContractNotFound", "Contract metadata required", null) else Expanded
				in Valid),
				    ProjectCheck = Table.NestedJoin(Input, {"Project ID"}, Dim_Project, {"Project ID"}, "_Project", JoinKind.LeftOuter),
				    CurrencyCheck = Table.ExpandTableColumn(ProjectCheck, "_Project", {"Currency"}, {"_ExpectedCurrency"}),
				    Valid = if Table.RowCount(Table.SelectRows(CurrencyCheck, each [_ExpectedCurrency] = null or [Currency] = null or [Currency] <> [_ExpectedCurrency])) > 0 then error Error.Record("ProjectCurrencyMismatch", "Fact_Collections", null) else Table.RemoveColumns(CurrencyCheck,{"_ExpectedCurrency"}),
				    PlanCheck = Table.NestedJoin(Valid,{"Plan ID"},Fact_PaymentPlan,{"Plan ID"},"_Plan",JoinKind.LeftOuter),
				    KeyCheck = if Table.RowCount(Table.SelectRows(PlanCheck, each Table.RowCount([_Plan]) <> 1 or [_Plan]{0}[Contract ID] <> [Contract ID])) > 0 then error Error.Record("CollectionPlanMismatch", "Plan and contract must match", null) else Table.RemoveColumns(PlanCheck,{"_Plan"})
				in KeyCheck
