		annotation UnderlyingDateTimeDataType = Date

	partition RAW_JSCV_BCC = m
		mode: import
		source =
				let
				    Fonte = RAW_ACCOUNTING_FILES,
				
				    // Selecionar ficheiros JSCV BCC
				    JSCV_BCC = Table.SelectRows(
				        Fonte,
				        each [Name] <> null
				            and Text.Contains(
				                Text.Upper(Text.From([Name])),
				                "JSCV_BCC"
				            )
				    ),
				
				    // Nome original do ficheiro
				    SourceFile = Table.AddColumn(
				        JSCV_BCC,
				        "Source File",
				        each [Name],
				        type text
				    ),
				
				    // Empresa
				    CompanyID = Table.AddColumn(
				        SourceFile,
				        "Company ID",
				        each "JSCV",
				        type text
				    ),
				
				    // Tipo de fonte
				    SourceType = Table.AddColumn(
				        CompanyID,
				        "Source Type",
				        each "BCC",
				        type text
				    ),
				
				    // Retirar extensão
				    FileBase = Table.AddColumn(
				        SourceType,
				        "_FileBase",
				        each Text.BeforeDelimiter(
				            Text.From([Name]),
				            ".xlsx"
				        ),
				        type text
				    ),
				
				    // Separar JSCV_BCC_ANO_MES
				    FileParts = Table.AddColumn(
				        FileBase,
				        "_Parts",
				        each Text.Split([_FileBase], "_")
				    ),
				
				    // Extrair Ano
				    Year = Table.AddColumn(
				        FileParts,
				        "Year",
				        each try Number.FromText([_Parts]{2}) otherwise null,
				        Int64.Type
				    ),
				
				    // Extrair Mês
				    Month = Table.AddColumn(
				        Year,
				        "Month",
				        each try Number.FromText([_Parts]{3}) otherwise null,
				        Int64.Type
				    ),
				
				    // Apenas meses contabilísticos 1-12
				    MesesValidos = Table.SelectRows(
				        Month,
				        each [Year] <> null
				            and [Month] <> null
				            and [Month] >= 1
				            and [Month] <= 12
				    ),
				
				    // YYYYMM
				    PeriodID = Table.AddColumn(
				        MesesValidos,
				        "Period ID",
				        each [Year] * 100 + [Month],
				        Int64.Type
				    ),
				
				    // Último dia do período
				    PeriodDate = Table.AddColumn(
				        PeriodID,
				        "Period Date",
				        each Date.EndOfMonth(
				            #date([Year], [Month], 1)
				        ),
				        type date
				    ),
				
				    // Remover colunas auxiliares
				    LimparAuxiliares = Table.RemoveColumns(
				        PeriodDate,
				        {"_FileBase", "_Parts"}
				    ),
				
				    // Ordenar cronologicamente
				    Ordenar = Table.Sort(
				        LimparAuxiliares,
				        {
				            {"Year", Order.Ascending},
				            {"Month", Order.Ascending}
				        }
				    )
				
				in
				    Ordenar

	annotation PBI_ResultType = Table

