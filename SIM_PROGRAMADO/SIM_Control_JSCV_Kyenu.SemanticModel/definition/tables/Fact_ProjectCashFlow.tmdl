	partition 'Fact_ProjectCashFlow' = m
		mode: import
		source =
				let
				    Input = (SIM_LoadCSV("ProjectCashFlow.csv", {{"Company ID", type text}, {"Project ID", type text}, {"Date", type date}, {"Phase", type text}, {"Currency", type text}, {"Cash Requirement", type number}, {"Project Cash Available", type number}, {"Expected Collections", type number}, {"Available Financing", type number}, {"Available Equity", type number}, {"Equity Cash Flow", type number}, {"Snapshot Date", type date}}, {"Company ID", "Project ID", "Date", "Phase", "Snapshot Date"})),
				    ProjectCheck = Table.NestedJoin(Input, {"Project ID"}, Dim_Project, {"Project ID"}, "_Project", JoinKind.LeftOuter),
				    CurrencyCheck = Table.ExpandTableColumn(ProjectCheck, "_Project", {"Currency"}, {"_ExpectedCurrency"}),
				    Valid = if Table.RowCount(Table.SelectRows(CurrencyCheck, each [_ExpectedCurrency] = null or [Currency] = null or [Currency] <> [_ExpectedCurrency])) > 0 then error Error.Record("ProjectCurrencyMismatch", "Fact_ProjectCashFlow", null) else Table.RemoveColumns(CurrencyCheck,{"_ExpectedCurrency"})
				in Valid
