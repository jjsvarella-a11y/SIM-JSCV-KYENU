	partition RAW_KYENU_BG = m
		mode: import
		source =
				let
				    Fonte = RAW_ACCOUNTING_FILES,
				
				    KYENU_BG = Table.SelectRows(
				        Fonte,
				        each [Name] <> null
				            and Text.Contains(
				                Text.Upper(Text.From([Name])),
				                "KYENU_BG"
				            )
				    ),
				
				    SourceFile = Table.AddColumn(
				        KYENU_BG,
				        "Source File",
				        each [Name],
				        type text
				    ),
				
				    CompanyID = Table.AddColumn(
				        SourceFile,
				        "Company ID",
				        each "KYENU",
				        type text
				    ),
				
				    SourceType = Table.AddColumn(
				        CompanyID,
				        "Source Type",
				        each "BG",
				        type text
				    ),
				
				    FileBase = Table.AddColumn(
				        SourceType,
				        "_FileBase",
				        each Text.BeforeDelimiter(
				            Text.From([Name]),
				            ".xlsx"
				        ),
				        type text
				    ),
				
				    FileParts = Table.AddColumn(
				        FileBase,
				        "_Parts",
				        each Text.Split([_FileBase], "_")
				    ),
				
				    Year = Table.AddColumn(
				        FileParts,
				        "Year",
				        each try Number.FromText([_Parts]{2}) otherwise null,
				        Int64.Type
				    ),
				
				    Month = Table.AddColumn(
				        Year,
				        "Month",
				        each try Number.FromText([_Parts]{3}) otherwise null,
				        Int64.Type
				    ),
				
				    MesesValidos = Table.SelectRows(
				        Month,
				        each [Year] <> null
				            and [Month] <> null
				            and [Month] >= 1
				            and [Month] <= 12
				    ),
				
				    PeriodID = Table.AddColumn(
				        MesesValidos,
				        "Period ID",
				        each [Year] * 100 + [Month],
				        Int64.Type
				    ),
				
				    PeriodDate = Table.AddColumn(
				        PeriodID,
				        "Period Date",
				        each Date.EndOfMonth(
				            #date([Year], [Month], 1)
				        ),
				        type date
				    ),
				
				    LimparAuxiliares = Table.RemoveColumns(
				        PeriodDate,
				        {"_FileBase", "_Parts"}
				    ),
				
				    Ordenar = Table.Sort(
				        LimparAuxiliares,
				        {
				            {"Year", Order.Ascending},
				            {"Month", Order.Ascending}
				        }
				    )
				
				in
				    Ordenar

	annotation PBI_ResultType = Table

