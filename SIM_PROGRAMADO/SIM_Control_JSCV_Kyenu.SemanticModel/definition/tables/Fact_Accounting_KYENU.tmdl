	partition Fact_Accounting_KYENU = m
		mode: import
		source =
				let
				    Fonte = RAW_KYENU_BG,
				
				    TransformarBG = (Binario as binary) as table =>
				        let
				            WB = Excel.Workbook(Binario, null, true),
				
				            ComCabecalhos = Table.AddColumn(
				                WB,
				                "_DadosPreparados",
				                each
				                    try
				                        Table.PromoteHeaders(
				                            [Data],
				                            [PromoteAllScalars = true]
				                        )
				                    otherwise null
				            ),
				
				            ComBG = Table.AddColumn(
				                ComCabecalhos,
				                "_EhBG",
				                each
				                    try
				                        List.Contains(
				                            Table.ColumnNames([_DadosPreparados]),
				                            "Conta"
				                        )
				                    otherwise false,
				                type logical
				            ),
				
				            ApenasBG = Table.SelectRows(
				                ComBG,
				                each [_EhBG] = true
				            ),
				
				            Resultado =
				                if Table.RowCount(ApenasBG) > 0
				                then ApenasBG{0}[_DadosPreparados]
				                else #table(
				                    {
				                        "Conta",
				                        "Descrição",
				                        "Débito (Per.)",
				                        "Crédito (Per.)",
				                        "Saldo (Per.)",
				                        "Débito (Acum.)",
				                        "Crédito (Acum.)",
				                        "Saldo (Acum.)"
				                    },
				                    {}
				                )
				        in
				            Resultado,
				
				    AdicionarDados = Table.AddColumn(
				        Fonte,
				        "Accounting Data",
				        each TransformarBG([Content]),
				        type table
				    ),
				
				    ManterColunas = Table.SelectColumns(
				        AdicionarDados,
				        {
				            "Source File",
				            "Company ID",
				            "Source Type",
				            "Year",
				            "Month",
				            "Period ID",
				            "Period Date",
				            "Accounting Data"
				        }
				    ),
				
				    ExpandirDados = Table.ExpandTableColumn(
				        ManterColunas,
				        "Accounting Data",
				        {
				            "Conta",
				            "Descrição",
				            "Débito (Per.)",
				            "Crédito (Per.)",
				            "Saldo (Per.)",
				            "Débito (Acum.)",
				            "Crédito (Acum.)",
				            "Saldo (Acum.)"
				        },
				        {
				            "Account ID",
				            "Account Name",
				            "Debit Period",
				            "Credit Period",
				            "Balance Period",
				            "Debit YTD",
				            "Credit YTD",
				            "Balance YTD"
				        }
				    ),
				
				    RemoverVazios = Table.SelectRows(
				        ExpandirDados,
				        each [Account ID] <> null
				            or [Account Name] <> null
				    ),
				
				    Tipos = Table.TransformColumnTypes(
				        RemoverVazios,
				        {
				            {"Source File", type text},
				            {"Company ID", type text},
				            {"Source Type", type text},
				            {"Year", Int64.Type},
				            {"Month", Int64.Type},
				            {"Period ID", Int64.Type},
				            {"Period Date", type date},
				            {"Account ID", type text},
				            {"Account Name", type text},
				            {"Debit Period", type number},
				            {"Credit Period", type number},
				            {"Balance Period", type number},
				            {"Debit YTD", type number},
				            {"Credit YTD", type number},
				            {"Balance YTD", type number}
				        }
				    ),
				
				    Ordenar = Table.Sort(
				        Tipos,
				        {
				            {"Period ID", Order.Ascending},
				            {"Account ID", Order.Ascending}
				        }
				    )
				
				in
				    Ordenar

	annotation PBI_ResultType = Table

