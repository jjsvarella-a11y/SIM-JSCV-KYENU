table _Measures
	lineageTag: cf1453c3-65bf-45ed-83c6-4047e6f8431b

	measure Revenue =
			
			CALCULATE(
			    SUM('Fact_Accounting'[Balance Period]),
			    'Dim_Account'[Management Group] = "Revenue",
			    'Dim_Account'[Account Level] = 2
			)
		lineageTag: 7febfa24-962b-4971-b1fc-1a32b006d985

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Teste Linhas Fact' =
			
			COUNTROWS('Fact_Accounting')
		formatString: 0
		lineageTag: 546365b1-776f-4eb8-9a87-98e330b1c318

	measure 'Teste Empresas Fact' =
			
			CONCATENATEX(
			    VALUES('Fact_Accounting'[Company ID]),
			    'Fact_Accounting'[Company ID],
			    " | "
			)
		lineageTag: 0aff7948-15bd-44e9-ad0d-97d2740be2d8

	/// Normal debit or credit side; reversals preserved. Missing records return BLANK.
	measure 'Direct Costs' =
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), 'Dim_Account'[Management Group] = "Direct / Production Costs", 'Dim_Account'[Account Level] = 2)
			VAR v_RequiredMonths = COUNTROWS(SUMMARIZE('Dim_Date', 'Dim_Date'[Period ID]))
			VAR v_AvailableMonths = CALCULATE(DISTINCTCOUNT('Fact_Accounting'[Period ID]), 'Dim_Account'[Management Group] = "Direct / Production Costs", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit Period]) || ISBLANK('Fact_Accounting'[Credit Period]))), 'Dim_Account'[Management Group] = "Direct / Production Costs", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_AvailableMonths = v_RequiredMonths && v_MissingAmounts = 0, CALCULATE(SUM('Fact_Accounting'[Debit Period]) - SUM('Fact_Accounting'[Credit Period]), 'Dim_Account'[Management Group] = "Direct / Production Costs", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 68dcfea7-be18-4e45-a9c1-86f258c2f6e7
		displayFolder: SIM / KPI Engine

	/// Normal debit or credit side; reversals preserved. Missing records return BLANK.
	measure 'FSE' =
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), 'Dim_Account'[Management Group] = "FSE", 'Dim_Account'[Account Level] = 2)
			VAR v_RequiredMonths = COUNTROWS(SUMMARIZE('Dim_Date', 'Dim_Date'[Period ID]))
			VAR v_AvailableMonths = CALCULATE(DISTINCTCOUNT('Fact_Accounting'[Period ID]), 'Dim_Account'[Management Group] = "FSE", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit Period]) || ISBLANK('Fact_Accounting'[Credit Period]))), 'Dim_Account'[Management Group] = "FSE", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_AvailableMonths = v_RequiredMonths && v_MissingAmounts = 0, CALCULATE(SUM('Fact_Accounting'[Debit Period]) - SUM('Fact_Accounting'[Credit Period]), 'Dim_Account'[Management Group] = "FSE", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 41e0d1b0-ad82-5606-bdc3-1566945bf585
		displayFolder: SIM / KPI Engine

	/// Normal debit or credit side; reversals preserved. Missing records return BLANK.
	measure 'Payroll' =
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), 'Dim_Account'[Management Group] = "Payroll", 'Dim_Account'[Account Level] = 2)
			VAR v_RequiredMonths = COUNTROWS(SUMMARIZE('Dim_Date', 'Dim_Date'[Period ID]))
			VAR v_AvailableMonths = CALCULATE(DISTINCTCOUNT('Fact_Accounting'[Period ID]), 'Dim_Account'[Management Group] = "Payroll", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit Period]) || ISBLANK('Fact_Accounting'[Credit Period]))), 'Dim_Account'[Management Group] = "Payroll", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_AvailableMonths = v_RequiredMonths && v_MissingAmounts = 0, CALCULATE(SUM('Fact_Accounting'[Debit Period]) - SUM('Fact_Accounting'[Credit Period]), 'Dim_Account'[Management Group] = "Payroll", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: de9c2dfb-ff53-5181-b149-377e2beb9256
		displayFolder: SIM / KPI Engine

	/// Normal debit or credit side; reversals preserved. Missing records return BLANK.
	measure 'Other Operating Costs' =
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), 'Dim_Account'[Management Group] = "Other Operating Costs", 'Dim_Account'[Account Level] = 2)
			VAR v_RequiredMonths = COUNTROWS(SUMMARIZE('Dim_Date', 'Dim_Date'[Period ID]))
			VAR v_AvailableMonths = CALCULATE(DISTINCTCOUNT('Fact_Accounting'[Period ID]), 'Dim_Account'[Management Group] = "Other Operating Costs", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit Period]) || ISBLANK('Fact_Accounting'[Credit Period]))), 'Dim_Account'[Management Group] = "Other Operating Costs", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_AvailableMonths = v_RequiredMonths && v_MissingAmounts = 0, CALCULATE(SUM('Fact_Accounting'[Debit Period]) - SUM('Fact_Accounting'[Credit Period]), 'Dim_Account'[Management Group] = "Other Operating Costs", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: be4e83ba-79e9-577c-b2cf-8643070f0412
		displayFolder: SIM / KPI Engine

	/// Normal debit or credit side; reversals preserved. Missing records return BLANK.
	measure 'D&A' =
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), 'Dim_Account'[Management Group] = "D&A", 'Dim_Account'[Account Level] = 2)
			VAR v_RequiredMonths = COUNTROWS(SUMMARIZE('Dim_Date', 'Dim_Date'[Period ID]))
			VAR v_AvailableMonths = CALCULATE(DISTINCTCOUNT('Fact_Accounting'[Period ID]), 'Dim_Account'[Management Group] = "D&A", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit Period]) || ISBLANK('Fact_Accounting'[Credit Period]))), 'Dim_Account'[Management Group] = "D&A", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_AvailableMonths = v_RequiredMonths && v_MissingAmounts = 0, CALCULATE(SUM('Fact_Accounting'[Debit Period]) - SUM('Fact_Accounting'[Credit Period]), 'Dim_Account'[Management Group] = "D&A", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 7f8db9d6-fa1f-5b3c-b17b-603ccfecf03d
		displayFolder: SIM / KPI Engine

	/// Normal debit or credit side; reversals preserved. Missing records return BLANK.
	measure 'Finance Costs' =
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), 'Dim_Account'[Management Group] = "Finance Costs", 'Dim_Account'[Account Level] = 2)
			VAR v_RequiredMonths = COUNTROWS(SUMMARIZE('Dim_Date', 'Dim_Date'[Period ID]))
			VAR v_AvailableMonths = CALCULATE(DISTINCTCOUNT('Fact_Accounting'[Period ID]), 'Dim_Account'[Management Group] = "Finance Costs", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit Period]) || ISBLANK('Fact_Accounting'[Credit Period]))), 'Dim_Account'[Management Group] = "Finance Costs", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_AvailableMonths = v_RequiredMonths && v_MissingAmounts = 0, CALCULATE(SUM('Fact_Accounting'[Debit Period]) - SUM('Fact_Accounting'[Credit Period]), 'Dim_Account'[Management Group] = "Finance Costs", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 053f428f-f622-573b-8646-12c5f960e968
		displayFolder: SIM / KPI Engine

	/// Normal debit or credit side; reversals preserved. Missing records return BLANK.
	measure 'Other Operating Income' =
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), 'Dim_Account'[Management Group] = "Other Income", 'Dim_Account'[Account Level] = 2)
			VAR v_RequiredMonths = COUNTROWS(SUMMARIZE('Dim_Date', 'Dim_Date'[Period ID]))
			VAR v_AvailableMonths = CALCULATE(DISTINCTCOUNT('Fact_Accounting'[Period ID]), 'Dim_Account'[Management Group] = "Other Income", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit Period]) || ISBLANK('Fact_Accounting'[Credit Period]))), 'Dim_Account'[Management Group] = "Other Income", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_AvailableMonths = v_RequiredMonths && v_MissingAmounts = 0, CALCULATE(SUM('Fact_Accounting'[Credit Period]) - SUM('Fact_Accounting'[Debit Period]), 'Dim_Account'[Management Group] = "Other Income", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: af85eefc-f369-59db-9efd-dd2380f852fd
		displayFolder: SIM / KPI Engine

	/// Normal debit or credit side; reversals preserved. Missing records return BLANK.
	measure 'Finance Income' =
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), 'Dim_Account'[Management Group] = "Finance Income", 'Dim_Account'[Account Level] = 2)
			VAR v_RequiredMonths = COUNTROWS(SUMMARIZE('Dim_Date', 'Dim_Date'[Period ID]))
			VAR v_AvailableMonths = CALCULATE(DISTINCTCOUNT('Fact_Accounting'[Period ID]), 'Dim_Account'[Management Group] = "Finance Income", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit Period]) || ISBLANK('Fact_Accounting'[Credit Period]))), 'Dim_Account'[Management Group] = "Finance Income", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_AvailableMonths = v_RequiredMonths && v_MissingAmounts = 0, CALCULATE(SUM('Fact_Accounting'[Credit Period]) - SUM('Fact_Accounting'[Debit Period]), 'Dim_Account'[Management Group] = "Finance Income", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: f7944e42-c033-5469-af8f-6de0b6b0639c
		displayFolder: SIM / KPI Engine

	measure 'Other Income' =
			[Other Operating Income]
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 07dc37fa-a9c7-5418-a7c9-14caa38b7b43
		displayFolder: SIM / KPI Engine

	measure 'Gross Profit' =
			IF(NOT ISBLANK([Revenue]) && NOT ISBLANK([Direct Costs]), [Revenue] - [Direct Costs])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 04d8d8b7-2c51-5c08-8c84-a88afd2f1151
		displayFolder: SIM / KPI Engine

	measure 'Gross Margin' =
			DIVIDE([Gross Profit], [Revenue])
		formatString: 0.0%
		lineageTag: 9d43b267-3286-55a0-af02-4ef76f500a70
		displayFolder: SIM / KPI Engine

	measure 'EBITDA' =
			IF(NOT ISBLANK([Revenue]) && NOT ISBLANK([Other Operating Income]) && NOT ISBLANK([Direct Costs]) && NOT ISBLANK([FSE]) && NOT ISBLANK([Payroll]) && NOT ISBLANK([Other Operating Costs]), [Revenue] + [Other Operating Income] - [Direct Costs] - [FSE] - [Payroll] - [Other Operating Costs])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: d9ae1808-83ef-579c-bf95-74cf91590207
		displayFolder: SIM / KPI Engine

	measure 'EBITDA Margin' =
			DIVIDE([EBITDA], [Revenue])
		formatString: 0.0%
		lineageTag: 8f8be004-1dcb-5181-85c4-9036de6d188a
		displayFolder: SIM / KPI Engine

	measure 'EBIT' =
			IF(NOT ISBLANK([EBITDA]) && NOT ISBLANK([D&A]), [EBITDA] - [D&A])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: d7ee24aa-8847-5fd2-b019-4b1cc6550913
		displayFolder: SIM / KPI Engine

	measure 'EBIT Margin' =
			DIVIDE([EBIT], [Revenue])
		formatString: 0.0%
		lineageTag: 5a2e382d-9b0b-577d-96b0-6df23dda589c
		displayFolder: SIM / KPI Engine

	measure 'Net Finance' =
			IF(NOT ISBLANK([Finance Income]) && NOT ISBLANK([Finance Costs]), [Finance Income] - [Finance Costs])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: e5520744-05ae-5661-9c37-6feda6ee0094
		displayFolder: SIM / KPI Engine

	measure 'Result Before Tax' =
			IF(NOT ISBLANK([EBIT]) && NOT ISBLANK([Net Finance]), [EBIT] + [Net Finance])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 4b46cdc9-0599-59ac-9129-e80303a623e1
		displayFolder: SIM / KPI Engine

	measure 'Income Tax' =
			VAR v_StartDate = MIN('Dim_Date'[Date])
			VAR v_EndDate = MAX('Dim_Date'[Date])
			VAR v_Companies = VALUES('Dim_Company'[Company ID])
			VAR v_TaxRows = FILTER('Fact_IncomeTax', 'Fact_IncomeTax'[Period Date] >= v_StartDate && 'Fact_IncomeTax'[Period Date] <= v_EndDate && 'Fact_IncomeTax'[Company ID] IN v_Companies && 'Fact_IncomeTax'[Approved] = TRUE())
			VAR v_MonthsRequired = COUNTROWS(SUMMARIZE('Dim_Date', 'Dim_Date'[Period ID]))
			RETURN IF(COUNTROWS(FILTER(v_TaxRows, NOT ISBLANK('Fact_IncomeTax'[Tax Expense]))) = v_MonthsRequired * COUNTROWS(v_Companies), SUMX(v_TaxRows, 'Fact_IncomeTax'[Tax Expense]))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 75057dd1-54c4-56fb-88cf-e80f4ea468db
		displayFolder: SIM / KPI Engine

	measure 'Net Result' =
			IF(NOT ISBLANK([Result Before Tax]) && NOT ISBLANK([Income Tax]), [Result Before Tax] - [Income Tax])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 951bd78f-3f2e-5050-ae93-5532a47e4713
		displayFolder: SIM / KPI Engine

	measure 'Net Margin' =
			DIVIDE([Net Result], [Revenue])
		formatString: 0.0%
		lineageTag: d6e1adef-0bb7-5cb6-85b8-c13b28006f96
		displayFolder: SIM / KPI Engine

	/// End-of-period signed cumulative balance; never sums monthly snapshots.
	measure 'Cash' =
			VAR v_AsOf = EOMONTH(MAX('Dim_Date'[Date]), 0)
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Cash & Cash Equivalents", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit YTD]) || ISBLANK('Fact_Accounting'[Credit YTD]))), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Cash & Cash Equivalents", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_MissingAmounts = 0, CALCULATE(1 * (SUM('Fact_Accounting'[Debit YTD]) - SUM('Fact_Accounting'[Credit YTD])), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Cash & Cash Equivalents", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: c24706a9-2f6f-5fef-b7ba-ece5a103d0ac
		displayFolder: SIM / KPI Engine

	/// End-of-period signed cumulative balance; never sums monthly snapshots.
	measure 'Accounts Receivable' =
			VAR v_AsOf = EOMONTH(MAX('Dim_Date'[Date]), 0)
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Accounts Receivable", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit YTD]) || ISBLANK('Fact_Accounting'[Credit YTD]))), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Accounts Receivable", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_MissingAmounts = 0, CALCULATE(1 * (SUM('Fact_Accounting'[Debit YTD]) - SUM('Fact_Accounting'[Credit YTD])), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Accounts Receivable", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 0f5298b9-cea6-52d0-8000-1ecd9b5eb753
		displayFolder: SIM / KPI Engine

	/// End-of-period signed cumulative balance; never sums monthly snapshots.
	measure 'Accounts Payable' =
			VAR v_AsOf = EOMONTH(MAX('Dim_Date'[Date]), 0)
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Accounts Payable", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit YTD]) || ISBLANK('Fact_Accounting'[Credit YTD]))), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Accounts Payable", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_MissingAmounts = 0, CALCULATE(-1 * (SUM('Fact_Accounting'[Debit YTD]) - SUM('Fact_Accounting'[Credit YTD])), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Accounts Payable", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 01aaabc1-c92d-5295-8809-5589eb0188f3
		displayFolder: SIM / KPI Engine

	/// End-of-period signed cumulative balance; never sums monthly snapshots.
	measure 'Inventory / WIP' =
			VAR v_AsOf = EOMONTH(MAX('Dim_Date'[Date]), 0)
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Inventory / WIP", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit YTD]) || ISBLANK('Fact_Accounting'[Credit YTD]))), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Inventory / WIP", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_MissingAmounts = 0, CALCULATE(1 * (SUM('Fact_Accounting'[Debit YTD]) - SUM('Fact_Accounting'[Credit YTD])), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Inventory / WIP", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: a68d30e0-8f1f-5d39-b82e-647a2bd4587c
		displayFolder: SIM / KPI Engine

	/// End-of-period signed cumulative balance; never sums monthly snapshots.
	measure 'Debt' =
			VAR v_AsOf = EOMONTH(MAX('Dim_Date'[Date]), 0)
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Financing / Debt", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit YTD]) || ISBLANK('Fact_Accounting'[Credit YTD]))), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Financing / Debt", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_MissingAmounts = 0, CALCULATE(-1 * (SUM('Fact_Accounting'[Debit YTD]) - SUM('Fact_Accounting'[Credit YTD])), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Financing / Debt", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 13e6f53d-8102-5733-a584-4e7f06462676
		displayFolder: SIM / KPI Engine

	/// End-of-period signed cumulative balance; never sums monthly snapshots.
	measure 'Equity' =
			VAR v_AsOf = EOMONTH(MAX('Dim_Date'[Date]), 0)
			VAR v_Records = CALCULATE(COUNTROWS('Fact_Accounting'), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Equity", 'Dim_Account'[Account Level] = 2)
			VAR v_MissingAmounts = CALCULATE(COUNTROWS(FILTER('Fact_Accounting', ISBLANK('Fact_Accounting'[Debit YTD]) || ISBLANK('Fact_Accounting'[Credit YTD]))), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Equity", 'Dim_Account'[Account Level] = 2)
			RETURN IF(v_Records > 0 && v_MissingAmounts = 0, CALCULATE(-1 * (SUM('Fact_Accounting'[Debit YTD]) - SUM('Fact_Accounting'[Credit YTD])), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Management Group] = "Equity", 'Dim_Account'[Account Level] = 2))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 3f7168de-9780-5847-a527-c036cccae5a6
		displayFolder: SIM / KPI Engine

	measure 'Balance Mapping Pending' =
			VAR v_AsOf = EOMONTH(MAX('Dim_Date'[Date]), 0)
			VAR v_Company = SELECTEDVALUE('Dim_Company'[Company ID])
			VAR v_Currency = SELECTEDVALUE('Dim_Company'[Currency])
			VAR v_RequiredIDs = CALCULATETABLE(VALUES('Fact_Accounting'[Account ID]), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Account Level] = 2, 'Dim_Account'[Balance Class] IN {"Requires Detail", "Debt"})
			RETURN SUMX(v_RequiredIDs,
			 VAR v_Id = 'Fact_Accounting'[Account ID]
			 VAR v_Net = CALCULATE(SUM('Fact_Accounting'[Debit YTD]) - SUM('Fact_Accounting'[Credit YTD]), REMOVEFILTERS('Dim_Date'), REMOVEFILTERS('Dim_Account'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Fact_Accounting'[Account ID] = v_Id)
			 VAR v_Parts = FILTER('Fact_BalanceBreakdown', 'Fact_BalanceBreakdown'[Company ID] = v_Company && 'Fact_BalanceBreakdown'[Period Date] = v_AsOf && 'Fact_BalanceBreakdown'[Account ID] = v_Id && 'Fact_BalanceBreakdown'[Approved] = TRUE())
			 VAR v_Invalid = COUNTROWS(FILTER(v_Parts, ISBLANK('Fact_BalanceBreakdown'[Value]) || 'Fact_BalanceBreakdown'[Currency] <> v_Currency || NOT ('Fact_BalanceBreakdown'[Balance Class] IN {"Current Asset","Non-Current Asset","Current Liability","Non-Current Liability","Equity"})))
			 VAR v_SignedParts = SUMX(v_Parts, IF('Fact_BalanceBreakdown'[Balance Class] IN {"Current Asset","Non-Current Asset"},1,-1) * 'Fact_BalanceBreakdown'[Value])
			 RETURN IF(COUNTROWS(v_Parts) = 0 || v_Invalid > 0 || ISBLANK(v_Net) || ABS(v_Net - v_SignedParts) > 0.01, 1, 0))
		formatString: 0
		lineageTag: 674ba6c6-1d22-5a0b-9b67-ad2b2c5815a6
		displayFolder: SIM / KPI Engine

	/// Approved split balances of account groups 23–28 must reconcile to the signed BG balance to 0.01 CVE. Empty current-class subset adds zero only after full reconciliation.
	measure 'Current Assets' =
			VAR v_AsOf = EOMONTH(MAX('Dim_Date'[Date]), 0)
			VAR v_Company = SELECTEDVALUE('Dim_Company'[Company ID])
			VAR v_Eligible = CALCULATETABLE(VALUES('Fact_Accounting'[Account ID]), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Account Level] = 2, 'Dim_Account'[Balance Class] IN {"Requires Detail", "Debt"})
			VAR v_Extra = FILTER('Fact_BalanceBreakdown', 'Fact_BalanceBreakdown'[Company ID] = v_Company && 'Fact_BalanceBreakdown'[Period Date] = v_AsOf && 'Fact_BalanceBreakdown'[Balance Class] = "Current Asset" && 'Fact_BalanceBreakdown'[Account ID] IN v_Eligible && 'Fact_BalanceBreakdown'[Approved] = TRUE())
			RETURN IF([Balance Mapping Pending] = 0 && NOT ISBLANK([Cash]) && NOT ISBLANK([Accounts Receivable]) && NOT ISBLANK([Inventory / WIP]), [Cash] + [Accounts Receivable] + [Inventory / WIP] + IF(COUNTROWS(v_Extra) = 0, 0, SUMX(v_Extra,'Fact_BalanceBreakdown'[Value])))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 11a56d68-e5e8-5ff3-ac6e-8a1aeb8f3dde
		displayFolder: SIM / KPI Engine

	/// Approved split balances of account groups 23–28 must reconcile to the signed BG balance to 0.01 CVE. Empty current-class subset adds zero only after full reconciliation.
	measure 'Current Liabilities' =
			VAR v_AsOf = EOMONTH(MAX('Dim_Date'[Date]), 0)
			VAR v_Company = SELECTEDVALUE('Dim_Company'[Company ID])
			VAR v_Eligible = CALCULATETABLE(VALUES('Fact_Accounting'[Account ID]), REMOVEFILTERS('Dim_Date'), 'Fact_Accounting'[Period Date] = v_AsOf, 'Dim_Account'[Account Level] = 2, 'Dim_Account'[Balance Class] IN {"Requires Detail", "Debt"})
			VAR v_Extra = FILTER('Fact_BalanceBreakdown', 'Fact_BalanceBreakdown'[Company ID] = v_Company && 'Fact_BalanceBreakdown'[Period Date] = v_AsOf && 'Fact_BalanceBreakdown'[Balance Class] = "Current Liability" && 'Fact_BalanceBreakdown'[Account ID] IN v_Eligible && 'Fact_BalanceBreakdown'[Approved] = TRUE())
			RETURN IF([Balance Mapping Pending] = 0 && NOT ISBLANK([Accounts Payable]), [Accounts Payable] + IF(COUNTROWS(v_Extra) = 0, 0, SUMX(v_Extra,'Fact_BalanceBreakdown'[Value])))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: d9f4d466-14dd-52bd-aa33-5a260fbe500e
		displayFolder: SIM / KPI Engine

	measure 'Working Capital' =
			IF(NOT ISBLANK([Current Assets]) && NOT ISBLANK([Current Liabilities]), [Current Assets] - [Current Liabilities])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 2894fa3f-430a-52de-a3ec-75d4adeeef8b
		displayFolder: SIM / KPI Engine

	measure 'Net Debt' =
			IF(NOT ISBLANK([Debt]) && NOT ISBLANK([Cash]), [Debt] - [Cash])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 8814b403-3594-5efa-99a0-d42ff3946cb0
		displayFolder: SIM / KPI Engine

	measure 'Current Ratio' =
			DIVIDE([Current Assets], [Current Liabilities])
		formatString: 0.00"x"
		lineageTag: ea29ccf7-8ffe-57f2-86ee-8529e0685a31
		displayFolder: SIM / KPI Engine

	measure 'Quick Ratio' =
			IF(NOT ISBLANK([Current Assets]) && NOT ISBLANK([Inventory / WIP]), DIVIDE([Current Assets] - [Inventory / WIP], [Current Liabilities]))
		formatString: 0.00"x"
		lineageTag: d37a138a-1aee-55d7-a9b5-b457a7221b03
		displayFolder: SIM / KPI Engine

	measure 'Immediate Liquidity' =
			DIVIDE([Cash], [Current Liabilities])
		formatString: 0.00"x"
		lineageTag: 7baed610-fa1d-52e3-8d77-6b52ee5846cc
		displayFolder: SIM / KPI Engine

	measure 'DSO' =
			DIVIDE([Accounts Receivable], [Revenue]) * COUNTROWS(VALUES('Dim_Date'[Date]))
		formatString: 0.0
