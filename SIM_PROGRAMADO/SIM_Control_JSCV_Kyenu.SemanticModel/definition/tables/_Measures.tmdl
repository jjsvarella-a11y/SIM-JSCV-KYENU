	/// Date stored as Excel serial number in ProjectMetrics.Value; preserve date format.
	measure 'Forecast Completion' =
			CALCULATE([Project Metric Raw], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Forecast Completion")
		formatString: yyyy-MM-dd
		lineageTag: 25850514-bbbd-5731-a966-3d891c72571f
		displayFolder: SIM / KPI Engine

	measure 'IRR' =
			VAR v_Phase = SELECTEDVALUE('SIM_Phase'[Phase], "CURRENT")
			VAR v_Reference = MAX('Dim_Date'[Date])
			VAR v_Snapshot = CALCULATE(MAX('Fact_ProjectCashFlow'[Snapshot Date]), 'Fact_ProjectCashFlow'[Phase] = v_Phase, 'Fact_ProjectCashFlow'[Snapshot Date] <= v_Reference)
			VAR v_Flows = FILTER('Fact_ProjectCashFlow', 'Fact_ProjectCashFlow'[Phase] = v_Phase && NOT ISBLANK('Fact_ProjectCashFlow'[Equity Cash Flow]))
			RETURN IF(HASONEVALUE('Dim_Project'[Project ID]) && COUNTROWS(FILTER(v_Flows, 'Fact_ProjectCashFlow'[Equity Cash Flow] < 0)) > 0 && COUNTROWS(FILTER(v_Flows, 'Fact_ProjectCashFlow'[Equity Cash Flow] > 0)) > 0, XIRR(v_Flows, 'Fact_ProjectCashFlow'[Equity Cash Flow], 'Fact_ProjectCashFlow'[Date], 0.1, BLANK()))
		formatString: 0.0%
		lineageTag: b2c26e16-35d9-5a84-a01f-92013c8f1499
		displayFolder: SIM / KPI Engine

	measure 'NPV' =
			VAR v_Phase = SELECTEDVALUE('SIM_Phase'[Phase], "CURRENT")
			VAR v_Reference = MAX('Dim_Date'[Date])
			VAR v_Snapshot = CALCULATE(MAX('Fact_ProjectCashFlow'[Snapshot Date]), 'Fact_ProjectCashFlow'[Phase] = v_Phase, 'Fact_ProjectCashFlow'[Snapshot Date] <= v_Reference)
			VAR v_Project = SELECTEDVALUE('Dim_Project'[Project ID])
			VAR v_Rate = CALCULATE(SELECTEDVALUE('SIM_ProjectAssumptions'[Discount Rate]), 'SIM_ProjectAssumptions'[Project ID] = v_Project, 'SIM_ProjectAssumptions'[Phase] = v_Phase)
			VAR v_Flows = FILTER('Fact_ProjectCashFlow', 'Fact_ProjectCashFlow'[Phase] = v_Phase && NOT ISBLANK('Fact_ProjectCashFlow'[Equity Cash Flow]))
			VAR v_FirstDate = MINX(v_Flows, 'Fact_ProjectCashFlow'[Date])
			RETURN IF(NOT ISBLANK(v_Rate) && v_Rate > -1 && COUNTROWS(v_Flows) > 0 && HASONEVALUE('Dim_Project'[Project ID]), SUMX(v_Flows, 'Fact_ProjectCashFlow'[Equity Cash Flow] / POWER(1 + v_Rate, DIVIDE(DATEDIFF(v_FirstDate, 'Fact_ProjectCashFlow'[Date], DAY), 365))))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 01cf3151-9ef7-5c10-933e-05b24fa264d6
		displayFolder: SIM / KPI Engine

	measure 'Funding Gap' =
			VAR v_Phase = SELECTEDVALUE('SIM_Phase'[Phase], "CURRENT")
			VAR v_Reference = MAX('Dim_Date'[Date])
			VAR v_Snapshot = CALCULATE(MAX('Fact_ProjectCashFlow'[Snapshot Date]), 'Fact_ProjectCashFlow'[Phase] = v_Phase, 'Fact_ProjectCashFlow'[Snapshot Date] <= v_Reference)
			VAR v_LastDate = CALCULATE(MAX('Fact_ProjectCashFlow'[Date]), 'Fact_ProjectCashFlow'[Phase] = v_Phase)
			VAR v_RowAtDate = FILTER('Fact_ProjectCashFlow', 'Fact_ProjectCashFlow'[Phase] = v_Phase && 'Fact_ProjectCashFlow'[Date] = v_LastDate)
			RETURN IF(HASONEVALUE('Dim_Project'[Project ID]) && COUNTROWS(v_RowAtDate) = 1 && COUNTROWS(FILTER(v_RowAtDate, ISBLANK('Fact_ProjectCashFlow'[Cash Requirement]) || ISBLANK('Fact_ProjectCashFlow'[Project Cash Available]) || ISBLANK('Fact_ProjectCashFlow'[Expected Collections]) || ISBLANK('Fact_ProjectCashFlow'[Available Financing]) || ISBLANK('Fact_ProjectCashFlow'[Available Equity]))) = 0,
			 MAX(0, SUMX(v_RowAtDate, 'Fact_ProjectCashFlow'[Cash Requirement] - 'Fact_ProjectCashFlow'[Project Cash Available] - 'Fact_ProjectCashFlow'[Expected Collections] - 'Fact_ProjectCashFlow'[Available Financing] - 'Fact_ProjectCashFlow'[Available Equity])))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: aabaf477-5a02-51a2-9344-0e000b0abfec
		displayFolder: SIM / KPI Engine

	measure 'Peak Funding Gap' =
			VAR v_Phase = SELECTEDVALUE('SIM_Phase'[Phase], "CURRENT")
			VAR v_Reference = MAX('Dim_Date'[Date])
			VAR v_Snapshot = CALCULATE(MAX('Fact_ProjectCashFlow'[Snapshot Date]), 'Fact_ProjectCashFlow'[Phase] = v_Phase, 'Fact_ProjectCashFlow'[Snapshot Date] <= v_Reference)
			VAR v_Flows = FILTER('Fact_ProjectCashFlow', 'Fact_ProjectCashFlow'[Phase] = v_Phase)
			VAR v_Incomplete = COUNTROWS(FILTER(v_Flows, ISBLANK('Fact_ProjectCashFlow'[Cash Requirement]) || ISBLANK('Fact_ProjectCashFlow'[Project Cash Available]) || ISBLANK('Fact_ProjectCashFlow'[Expected Collections]) || ISBLANK('Fact_ProjectCashFlow'[Available Financing]) || ISBLANK('Fact_ProjectCashFlow'[Available Equity])))
			RETURN IF(HASONEVALUE('Dim_Project'[Project ID]) && COUNTROWS(v_Flows) > 0 && v_Incomplete = 0, MAXX(v_Flows, MAX(0, 'Fact_ProjectCashFlow'[Cash Requirement] - 'Fact_ProjectCashFlow'[Project Cash Available] - 'Fact_ProjectCashFlow'[Expected Collections] - 'Fact_ProjectCashFlow'[Available Financing] - 'Fact_ProjectCashFlow'[Available Equity])))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 0fe8665d-3542-5149-9131-76ad5cb267e5
		displayFolder: SIM / KPI Engine

	measure 'Funding Coverage' =
			VAR v_Phase = SELECTEDVALUE('SIM_Phase'[Phase], "CURRENT")
			VAR v_Reference = MAX('Dim_Date'[Date])
			VAR v_Snapshot = CALCULATE(MAX('Fact_ProjectCashFlow'[Snapshot Date]), 'Fact_ProjectCashFlow'[Phase] = v_Phase, 'Fact_ProjectCashFlow'[Snapshot Date] <= v_Reference)
			VAR v_LastDate = CALCULATE(MAX('Fact_ProjectCashFlow'[Date]), 'Fact_ProjectCashFlow'[Phase] = v_Phase)
			VAR v_RowsAtDate = FILTER('Fact_ProjectCashFlow', 'Fact_ProjectCashFlow'[Phase] = v_Phase && 'Fact_ProjectCashFlow'[Date] = v_LastDate)
			RETURN IF(NOT ISBLANK([Funding Gap]), DIVIDE(SUMX(v_RowsAtDate, 'Fact_ProjectCashFlow'[Project Cash Available] + 'Fact_ProjectCashFlow'[Expected Collections] + 'Fact_ProjectCashFlow'[Available Financing] + 'Fact_ProjectCashFlow'[Available Equity]), SUMX(v_RowsAtDate, 'Fact_ProjectCashFlow'[Cash Requirement])))
		formatString: 0.0%
		lineageTag: a9701e27-d294-51d0-9b31-718415d32ba6
		displayFolder: SIM / KPI Engine

	measure 'Contracted Sales' =
			VAR v_EndDate = MAX('Dim_Date'[Date])
			RETURN CALCULATE(SUM('Fact_SalesContracts'[Contract Value]), 'Fact_SalesContracts'[Contract Date] <= v_EndDate, 'Fact_SalesContracts'[Status] <> "Cancelled")
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 103886b0-8cdb-530e-b026-57e105d18c9d
		displayFolder: SIM / KPI Engine

	measure 'Collections' =
			IF([Collection Feed Complete], VAR v_ActualReceipts = (VAR v_EndDate = MAX('Dim_Date'[Date])
			RETURN CALCULATE(SUM('Fact_Collections'[Amount]), 'Fact_Collections'[Actual Collection Date] <> BLANK(), 'Fact_Collections'[Actual Collection Date] <= v_EndDate, 'Fact_Collections'[Status] = "Paid")) RETURN IF(ISBLANK(v_ActualReceipts), 0, v_ActualReceipts))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 2729005a-e849-5567-88ba-7832c2f51bd7
		displayFolder: SIM / KPI Engine

	measure 'Commercial Receivables' =
			IF(NOT ISBLANK([Contracted Sales]) && NOT ISBLANK([Collections]), [Contracted Sales] - [Collections])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 5ae568df-d843-5c72-a3cb-47b67bf1358b
		displayFolder: SIM / KPI Engine

	measure 'Remaining GDV' =
			IF(NOT ISBLANK([GDV]) && NOT ISBLANK([Contracted Sales]), [GDV] - [Contracted Sales])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 02ee5945-315d-5006-a08d-18ccb9e36aa6
		displayFolder: SIM / KPI Engine

	measure 'Collection Rate' =
			DIVIDE([Collections], [Contracted Sales])
		formatString: 0.0%
		lineageTag: 70d83c36-91f6-5ddb-88aa-6bc0cfabc6ab
		displayFolder: SIM / KPI Engine

	measure '% Sold' =
			DIVIDE([Contracted Sales], [GDV])
		formatString: 0.0%
		lineageTag: 2835d1c5-d800-5619-93b9-b254b35abd54
		displayFolder: SIM / KPI Engine

	/// No receipt against a known scheduled installment is outstanding, not missing expected amount; missing feed flagged separately.
	measure 'Overdue Receivables' =
			IF([Collection Feed Complete], VAR v_EndDate = MAX('Dim_Date'[Date])
			VAR v_Plans = FILTER('Fact_PaymentPlan', 'Fact_PaymentPlan'[Due Date] < v_EndDate && 'Fact_PaymentPlan'[Status] <> "Cancelled")
			RETURN IF(COUNTROWS(v_Plans) > 0, SUMX(v_Plans, VAR v_Plan = 'Fact_PaymentPlan'[Plan ID]
			 VAR v_Due = 'Fact_PaymentPlan'[Expected Amount]
			 VAR v_Paid = CALCULATE(SUM('Fact_Collections'[Amount]), TREATAS({v_Plan}, 'Fact_Collections'[Plan ID]), 'Fact_Collections'[Actual Collection Date] <> BLANK(), 'Fact_Collections'[Actual Collection Date] <= v_EndDate, 'Fact_Collections'[Status] = "Paid")
			 RETURN IF(NOT ISBLANK(v_Due), MAX(0, v_Due - IF(ISBLANK(v_Paid), 0, v_Paid))))))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 546a23e0-21ee-5b09-9ddf-bed8f3c7156e
		displayFolder: SIM / KPI Engine

	measure 'Expected Collections' =
			IF([Collection Feed Complete], VAR v_EndDate = MAX('Dim_Date'[Date])
			VAR v_Plans = FILTER('Fact_PaymentPlan', 'Fact_PaymentPlan'[Forecast Collection Date] > v_EndDate && 'Fact_PaymentPlan'[Status] <> "Cancelled")
			RETURN IF(COUNTROWS(v_Plans) > 0, SUMX(v_Plans, VAR v_Plan = 'Fact_PaymentPlan'[Plan ID]
			 VAR v_Due = 'Fact_PaymentPlan'[Expected Amount]
			 VAR v_Paid = CALCULATE(SUM('Fact_Collections'[Amount]), TREATAS({v_Plan}, 'Fact_Collections'[Plan ID]), 'Fact_Collections'[Actual Collection Date] <> BLANK(), 'Fact_Collections'[Actual Collection Date] <= v_EndDate, 'Fact_Collections'[Status] = "Paid")
			 RETURN IF(NOT ISBLANK(v_Due), MAX(0, v_Due - IF(ISBLANK(v_Paid), 0, v_Paid))))))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: cfa6b49c-3063-5914-928f-c34bda698d41
		displayFolder: SIM / KPI Engine

	measure 'Units Sold' =
			VAR v_EndDate = MAX('Dim_Date'[Date])
			RETURN CALCULATE(DISTINCTCOUNT('Fact_SalesContracts'[Unit ID]), 'Fact_SalesContracts'[Contract Date] <= v_EndDate, 'Fact_SalesContracts'[Status] <> "Cancelled")
		formatString: 0
		lineageTag: 5f8c153f-be9c-58b6-89a5-5d8db3c1ecde
		displayFolder: SIM / KPI Engine

	measure 'Units Reserved' =
			VAR v_Projects = VALUES('Dim_Project'[Project ID])
			VAR v_RowsInProject = FILTER('Dim_Unit', 'Dim_Unit'[Project ID] IN v_Projects)
			RETURN IF(HASONEVALUE('Dim_Project'[Project ID]) && COUNTROWS(v_RowsInProject) > 0, COUNTROWS(FILTER(v_RowsInProject, 'Dim_Unit'[Status] = "Reserved")))
		formatString: 0
		lineageTag: f6c31130-5ceb-5d41-9860-b7f2287b5990
		displayFolder: SIM / KPI Engine

	measure 'Units Available' =
			VAR v_Projects = VALUES('Dim_Project'[Project ID])
			VAR v_RowsInProject = FILTER('Dim_Unit', 'Dim_Unit'[Project ID] IN v_Projects)
			RETURN IF(HASONEVALUE('Dim_Project'[Project ID]) && COUNTROWS(v_RowsInProject) > 0, COUNTROWS(FILTER(v_RowsInProject, 'Dim_Unit'[Status] = "Available")))
		formatString: 0
		lineageTag: af9b655f-a502-5d66-a722-eff7fbabc918
		displayFolder: SIM / KPI Engine

	measure 'Average Selling Price' =
			DIVIDE([Contracted Sales], [Units Sold])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 97a4764e-be7f-54ad-b801-3ff0c63d6af7
		displayFolder: SIM / KPI Engine

	measure 'Average Price m2' =
			VAR v_EndDate = MAX('Dim_Date'[Date])
			VAR v_Units = CALCULATETABLE(VALUES('Fact_SalesContracts'[Unit ID]), 'Fact_SalesContracts'[Contract Date] <= v_EndDate, 'Fact_SalesContracts'[Status] <> "Cancelled")
			VAR v_Area = CALCULATE(SUM('Dim_Unit'[Area m2]), TREATAS(v_Units, 'Dim_Unit'[Unit ID]))
			RETURN DIVIDE([Contracted Sales], v_Area)
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 0c5aea17-82e1-5234-b9f6-aa94fa799def
		displayFolder: SIM / KPI Engine

	measure 'Sales Velocity' =
			VAR v_StartDate = MIN('Dim_Date'[Date])
			VAR v_EndDate = MAX('Dim_Date'[Date])
			VAR v_Sales = CALCULATE(DISTINCTCOUNT('Fact_SalesContracts'[Contract ID]), 'Fact_SalesContracts'[Contract Date] >= v_StartDate, 'Fact_SalesContracts'[Contract Date] <= v_EndDate, 'Fact_SalesContracts'[Status] <> "Cancelled")
			RETURN DIVIDE(v_Sales, COUNTROWS(SUMMARIZE('Dim_Date', 'Dim_Date'[Period ID])))
		formatString: 0.0
		lineageTag: 0f18497d-c42a-512e-b9e7-47b98ddb0e5b
		displayFolder: SIM / KPI Engine

	/// Requires sourced cash available for debt service and amortization/interest schedule; cannot infer from trial balance.
	measure 'DSCR' =
			DIVIDE([Cash Available for Debt Service], [Debt Service])
		formatString: 0.00"x"
		lineageTag: fa896edc-f448-533b-97e5-4dd18d76f70d
		displayFolder: SIM / KPI Engine

	measure 'Selected Entity' =
			IF(NOT ISFILTERED('SIM_Entity'), "JSCV", SELECTEDVALUE('SIM_Entity'[Entity Key]))
		formatString: General
		lineageTag: adbac29a-cf36-5215-889b-08d44d9f2d99
		displayFolder: SIM / KPI Engine

	measure 'Selected Periodicity' =
			SELECTEDVALUE('SIM_Periodicity'[Periodicity], "Monthly")
		formatString: General
		lineageTag: fccde9c0-9b83-500b-bd26-b351da90e193
		displayFolder: SIM / KPI Engine

	measure 'Reference Date' =
			VAR v_Company = [Selected Entity]
			VAR v_AllowedDates = VALUES('SIM_ReferencePeriod'[Reference Date])
			VAR v_CompanyDate = CALCULATE(MAX('Fact_Accounting'[Period Date]), REMOVEFILTERS('Dim_Date'), TREATAS({v_Company}, 'Dim_Company'[Company ID]), TREATAS(v_AllowedDates,'Fact_Accounting'[Period Date]))
			VAR v_GroupDate = CALCULATE(MAX('Fact_Accounting'[Period Date]), REMOVEFILTERS('Dim_Date'), TREATAS(v_AllowedDates,'Fact_Accounting'[Period Date]))
			RETURN IF(ISFILTERED('SIM_ReferencePeriod'[Period]) || ISFILTERED('SIM_ReferencePeriod'[Reference Date]), MAX('SIM_ReferencePeriod'[Reference Date]), IF(v_Company = "CON", v_GroupDate, v_CompanyDate))
		formatString: yyyy-MM-dd
		lineageTag: 7090b0f9-89ce-54d5-b6eb-f4589cb8434d
		displayFolder: SIM / KPI Engine

	measure 'Context End' =
			VAR v_RefDate = [Reference Date]
			VAR v_OnTrend = ISINSCOPE('Dim_Date'[Year Month])
			VAR v_AxisDate = EOMONTH(MAX('Dim_Date'[Date]), 0)
			RETURN IF(v_OnTrend, IF(v_AxisDate <= v_RefDate && YEAR(v_AxisDate) = YEAR(v_RefDate), v_AxisDate), IF([Selected Periodicity] = "Annual", DATE(YEAR(v_RefDate),12,31), v_RefDate))
		formatString: yyyy-MM-dd
		lineageTag: 80592a21-48a9-5ff8-b521-d2a41bf8d59b
		displayFolder: SIM / KPI Engine

	measure 'Context Start' =
			VAR v_EndDate = [Context End]
			VAR v_Period = [Selected Periodicity]
			RETURN IF(NOT ISBLANK(v_EndDate), SWITCH(v_Period, "Monthly", DATE(YEAR(v_EndDate), MONTH(v_EndDate), 1), "Quarterly", DATE(YEAR(v_EndDate), 1 + 3 * INT((MONTH(v_EndDate)-1)/3), 1), "YTD", DATE(YEAR(v_EndDate),1,1), "Annual", DATE(YEAR(v_EndDate),1,1)))
		formatString: yyyy-MM-dd
		lineageTag: ba6558e9-d87c-5453-a5f1-cf7f6a1a6243
		displayFolder: SIM / KPI Engine

	measure 'Comparison End' =
			VAR v_RefDate = [Context End]
			VAR v_Mode = SELECTEDVALUE('SIM_Comparison'[Comparison], "Homologous Period")
			VAR v_Period = [Selected Periodicity]
			VAR v_YearChoice = SELECTEDVALUE('SIM_ComparisonYear'[Year])
			RETURN IF(NOT ISBLANK(v_RefDate), SWITCH(v_Mode,
			 "Homologous Period", EOMONTH(v_RefDate,-12),
			 "Previous Period", IF(v_Period <> "YTD", EOMONTH(v_RefDate, SWITCH(v_Period,"Monthly",-1,"Quarterly",-3,"Annual",-12))),
			 "Same Period of Selected Year", IF(NOT ISBLANK(v_YearChoice), EOMONTH(DATE(v_YearChoice,MONTH(v_RefDate),1),0)),
			 "Custom", SELECTEDVALUE('SIM_CustomEnd'[Reference Date])))
		formatString: yyyy-MM-dd
		lineageTag: 3d4af5c5-c856-54b5-81d6-c2374910ddb0
		displayFolder: SIM / KPI Engine

	measure 'Comparison Start' =
			VAR v_EndDate = [Comparison End]
			VAR v_Period = [Selected Periodicity]
			VAR v_Mode = SELECTEDVALUE('SIM_Comparison'[Comparison], "Homologous Period")
			VAR v_CustomStart = SELECTEDVALUE('SIM_CustomStart'[Reference Date])
			RETURN IF(NOT ISBLANK(v_EndDate), IF(v_Mode = "Custom", IF(NOT ISBLANK(v_CustomStart) && v_CustomStart <= v_EndDate, DATE(YEAR(v_CustomStart),MONTH(v_CustomStart),1)), SWITCH(v_Period,"Monthly",DATE(YEAR(v_EndDate),MONTH(v_EndDate),1),"Quarterly",DATE(YEAR(v_EndDate),1 + 3 * INT((MONTH(v_EndDate)-1)/3),1),"YTD",DATE(YEAR(v_EndDate),1,1),"Annual",DATE(YEAR(v_EndDate),1,1))))
		formatString: yyyy-MM-dd
		lineageTag: 92f2b637-672e-577d-b352-de8229c081e9
		displayFolder: SIM / KPI Engine

	measure 'KPI Base' =
			SWITCH(SELECTEDVALUE('SIM_KPI'[KPI ID]),
			 "Revenue", [Revenue],
			 "Direct Costs", [Direct Costs],
			 "Gross Profit", [Gross Profit],
			 "Gross Margin", [Gross Margin],
			 "FSE", [FSE],
			 "Payroll", [Payroll],
			 "Other Operating Costs", [Other Operating Costs],
			 "Other Operating Income", [Other Operating Income],
			 "EBITDA", [EBITDA],
			 "EBITDA Margin", [EBITDA Margin],
			 "D&A", [D&A],
			 "EBIT", [EBIT],
			 "EBIT Margin", [EBIT Margin],
			 "Finance Costs", [Finance Costs],
			 "Finance Income", [Finance Income],
			 "Net Finance", [Net Finance],
			 "Result Before Tax", [Result Before Tax],
			 "Net Result", [Net Result],
			 "Net Margin", [Net Margin],
			 "Cash", [Cash],
			 "Accounts Receivable", [Accounts Receivable],
			 "Accounts Payable", [Accounts Payable],
			 "Inventory / WIP", [Inventory / WIP],
			 "Current Assets", [Current Assets],
			 "Current Liabilities", [Current Liabilities],
			 "Working Capital", [Working Capital],
			 "Debt", [Debt],
			 "Net Debt", [Net Debt],
			 "Equity", [Equity],
			 "Current Ratio", [Current Ratio],
			 "Quick Ratio", [Quick Ratio],
			 "Immediate Liquidity", [Immediate Liquidity],
			 "DSO", [DSO],
			 "DPO", [DPO],
			 "GDV", [GDV],
			 "Initial Investment", [Initial Investment],
			 "Current Investment", [Current Investment],
			 "Investment Variance", [Investment Variance],
			 "Project Profit", [Project Profit],
			 "Development Margin", [Development Margin],
			 "Profit on Cost", [Profit on Cost],
			 "ROI", [ROI],
			 "IRR", [IRR],
			 "NPV", [NPV],
			 "Financing", [Financing],
			 "Project Equity", [Project Equity],
			 "LTC", [LTC],
			 "LTV", [LTV],
			 "Funding Coverage", [Funding Coverage],
			 "Funding Gap", [Funding Gap],
			 "Peak Funding Gap", [Peak Funding Gap],
			 "Physical Progress", [Physical Progress],
			 "Financial Progress", [Financial Progress],
			 "Actual Cost", [Actual Cost],
			 "Committed Cost", [Committed Cost],
			 "Cost to Complete", [Cost to Complete],
			 "CPI", [CPI],
			 "SPI", [SPI],
			 "Forecast Completion", [Forecast Completion],
			 "Contracted Sales", [Contracted Sales],
			 "Collections", [Collections],
			 "Commercial Receivables", [Commercial Receivables],
			 "Remaining GDV", [Remaining GDV],
			 "Overdue Receivables", [Overdue Receivables],
			 "Collection Rate", [Collection Rate],
			 "% Sold", [% Sold],
			 "Units Sold", [Units Sold],
			 "Units Reserved", [Units Reserved],
			 "Units Available", [Units Available],
			 "Average Selling Price", [Average Selling Price],
			 "Average Price m2", [Average Price m2],
			 "Sales Velocity", [Sales Velocity],
			 "Expected Collections", [Expected Collections],
			 "DSCR", [DSCR],
			 "Earned Value", [Earned Value],
			 "Planned Value", [Planned Value],
			 "Cash Available for Debt Service", [Cash Available for Debt Service], "Debt Service", [Debt Service], "Income Tax", [Income Tax], BLANK())
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 8a3c9f50-3e4e-53e0-92b1-7f39e479226f
		displayFolder: SIM / KPI Engine

	/// Consolidation explicitly BLANK pending reconciled eliminations; never blind sum.
	measure 'KPI Entity Value' =
			VAR v_Entity = [Selected Entity]
			VAR v_Kind = SELECTEDVALUE('SIM_KPI'[Kind])
			VAR v_Project = SELECTEDVALUE('Dim_Project'[Project ID])
			VAR v_ProjectCurrency = SELECTEDVALUE('Dim_Project'[Currency])
			RETURN IF(v_Entity = "CON", [KPI Consolidated Value], IF(v_Entity IN {"JSCV", "KYENU"} && (NOT (v_Kind IN {"Project", "Commercial"}) || (NOT ISBLANK(v_Project) && NOT ISBLANK(v_ProjectCurrency))), CALCULATE([KPI Base], TREATAS({v_Entity}, 'Dim_Company'[Company ID]))))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 93be4ca3-10c2-5010-962c-01749b4a8d74
		displayFolder: SIM / KPI Engine

	measure 'KPI Actual' =
			IF(NOT [KPI Coverage Missing], VAR v_StartDate = [Context Start]
			VAR v_EndDate = [Context End]
			RETURN IF(NOT ISBLANK(v_StartDate) && NOT ISBLANK(v_EndDate), CALCULATE([KPI Entity Value], REMOVEFILTERS('Dim_Date'), DATESBETWEEN('Dim_Date'[Date],v_StartDate,v_EndDate))))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 21dc5758-2517-550b-93c5-deec657cbd2b
		displayFolder: SIM / KPI Engine

	measure 'KPI Plan Value' =
			VAR v_Entity = [Selected Entity]
			VAR v_RefDate = [Context End]
			VAR v_Period = [Selected Periodicity]
			VAR v_Id = SELECTEDVALUE('SIM_KPI'[KPI ID])
			VAR v_Mode = SELECTEDVALUE('SIM_Comparison'[Comparison], "Homologous Period")
			VAR v_Version = SELECTEDVALUE('SIM_Version'[Version])
			VAR v_Project = SELECTEDVALUE('Dim_Project'[Project ID], "")
			VAR v_Kind = SWITCH(v_Mode, "Budget", "BUDGET", "Target", "TARGET", "Forecast", "FORECAST")
			VAR v_Unit = [KPI Unit]
			VAR v_Plan = FILTER('Fact_KPIPlans', 'Fact_KPIPlans'[Entity Key] = v_Entity && 'Fact_KPIPlans'[Project ID] = v_Project && 'Fact_KPIPlans'[Period Date] = v_RefDate && 'Fact_KPIPlans'[Periodicity] = v_Period && 'Fact_KPIPlans'[KPI ID] = v_Id && 'Fact_KPIPlans'[Kind] = v_Kind && 'Fact_KPIPlans'[Version] = v_Version && 'Fact_KPIPlans'[Approved] = TRUE() && 'Fact_KPIPlans'[Unit] = v_Unit)
			RETURN IF(NOT ISBLANK(v_Version) && COUNTROWS(v_Plan) = 1, SUMX(v_Plan,'Fact_KPIPlans'[Value]))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 2b2e81b8-6a7f-5044-a74f-9a9aa27d9f3a
		displayFolder: SIM / KPI Engine

	measure 'KPI Comparative' =
			VAR v_Mode = SELECTEDVALUE('SIM_Comparison'[Comparison], "Homologous Period")
			VAR v_StartDate = [Comparison Start]
			VAR v_EndDate = [Comparison End]
			RETURN IF(v_Mode IN {"Budget","Target","Forecast"}, [KPI Plan Value], IF(NOT ISBLANK(v_StartDate) && NOT ISBLANK(v_EndDate), CALCULATE([KPI Entity Value], REMOVEFILTERS('Dim_Date'), DATESBETWEEN('Dim_Date'[Date],v_StartDate,v_EndDate))))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 39334019-3a79-5b90-bb9b-9816a01ae559
		displayFolder: SIM / KPI Engine

	measure 'KPI Variance' =
			IF(NOT ISBLANK([KPI Actual]) && NOT ISBLANK([KPI Comparative]), [KPI Actual] - [KPI Comparative])
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 2fd1a082-6c65-5ec9-995b-18fe6e755955
		displayFolder: SIM / KPI Engine

	measure 'KPI Variance %' =
			DIVIDE([KPI Variance], [KPI Comparative])
		formatString: 0.0%
		lineageTag: 8d1ac65e-ffb1-5c49-b013-f84378c96156
		displayFolder: SIM / KPI Engine

	measure 'KPI Target' =
			VAR v_Entity = [Selected Entity]
			VAR v_RefDate = [Context End]
			VAR v_Period = [Selected Periodicity]
			VAR v_Id = SELECTEDVALUE('SIM_KPI'[KPI ID])
			VAR v_Version = SELECTEDVALUE('SIM_Version'[Version])
			VAR v_Project = SELECTEDVALUE('Dim_Project'[Project ID], "")
			VAR v_Unit = [KPI Unit]
			VAR v_Plan = FILTER('Fact_KPIPlans', 'Fact_KPIPlans'[Entity Key] = v_Entity && 'Fact_KPIPlans'[Project ID] = v_Project && 'Fact_KPIPlans'[Period Date] = v_RefDate && 'Fact_KPIPlans'[Periodicity] = v_Period && 'Fact_KPIPlans'[KPI ID] = v_Id && 'Fact_KPIPlans'[Kind] = "TARGET" && 'Fact_KPIPlans'[Version] = v_Version && 'Fact_KPIPlans'[Approved] = TRUE() && 'Fact_KPIPlans'[Unit] = v_Unit)
			RETURN IF(NOT ISBLANK(v_Version) && COUNTROWS(v_Plan) = 1, SUMX(v_Plan,'Fact_KPIPlans'[Value]))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: de530e2d-876e-5d4d-9a29-8d8782a5b505
		displayFolder: SIM / KPI Engine

	measure 'KPI Limit' =
			VAR v_Entity = [Selected Entity]
			VAR v_RefDate = [Context End]
			VAR v_Period = [Selected Periodicity]
			VAR v_Id = SELECTEDVALUE('SIM_KPI'[KPI ID])
			VAR v_Version = SELECTEDVALUE('SIM_Version'[Version])
			VAR v_Project = SELECTEDVALUE('Dim_Project'[Project ID], "")
			VAR v_Unit = [KPI Unit]
			VAR v_Plan = FILTER('Fact_KPIPlans', 'Fact_KPIPlans'[Entity Key] = v_Entity && 'Fact_KPIPlans'[Project ID] = v_Project && 'Fact_KPIPlans'[Period Date] = v_RefDate && 'Fact_KPIPlans'[Periodicity] = v_Period && 'Fact_KPIPlans'[KPI ID] = v_Id && 'Fact_KPIPlans'[Kind] = "TARGET" && 'Fact_KPIPlans'[Version] = v_Version && 'Fact_KPIPlans'[Approved] = TRUE() && 'Fact_KPIPlans'[Unit] = v_Unit)
			RETURN IF(NOT ISBLANK(v_Version) && COUNTROWS(v_Plan) = 1, SUMX(v_Plan,'Fact_KPIPlans'[Limit]))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: 3efb2d57-4f75-529f-885f-faed13f4ddd1
		displayFolder: SIM / KPI Engine

	measure 'KPI Excellent' =
			VAR v_Entity = [Selected Entity]
			VAR v_RefDate = [Context End]
			VAR v_Period = [Selected Periodicity]
			VAR v_Id = SELECTEDVALUE('SIM_KPI'[KPI ID])
			VAR v_Version = SELECTEDVALUE('SIM_Version'[Version])
			VAR v_Project = SELECTEDVALUE('Dim_Project'[Project ID], "")
			VAR v_Unit = [KPI Unit]
			VAR v_Plan = FILTER('Fact_KPIPlans', 'Fact_KPIPlans'[Entity Key] = v_Entity && 'Fact_KPIPlans'[Project ID] = v_Project && 'Fact_KPIPlans'[Period Date] = v_RefDate && 'Fact_KPIPlans'[Periodicity] = v_Period && 'Fact_KPIPlans'[KPI ID] = v_Id && 'Fact_KPIPlans'[Kind] = "TARGET" && 'Fact_KPIPlans'[Version] = v_Version && 'Fact_KPIPlans'[Approved] = TRUE() && 'Fact_KPIPlans'[Unit] = v_Unit)
			RETURN IF(NOT ISBLANK(v_Version) && COUNTROWS(v_Plan) = 1, SUMX(v_Plan,'Fact_KPIPlans'[Excellent]))
		formatString: #,0.00;(#,0.00);0.00
		lineageTag: d8bcf5f7-6f7c-557e-a25d-3194308bfec2
		displayFolder: SIM / KPI Engine

	measure 'KPI Status' =
			VAR v_Entity = [Selected Entity]
			VAR v_Id = SELECTEDVALUE('SIM_KPI'[KPI ID])
			VAR v_Kind = SELECTEDVALUE('SIM_KPI'[Kind])
			VAR v_Value = [KPI Actual]
			VAR v_Target = [KPI Target]
			VAR v_Limit = [KPI Limit]
			VAR v_Excellent = [KPI Excellent]
			VAR v_Direction = SELECTEDVALUE('SIM_KPI'[Desired Direction], "Higher")
			VAR v_Denominator = SWITCH(v_Id,
			 "Gross Margin", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Revenue"),
			 "EBITDA Margin", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Revenue"),
			 "EBIT Margin", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Revenue"),
			 "Net Margin", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Revenue"),
			 "DSO", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Revenue"),
			 "DPO", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Direct Costs"),
			 "Current Ratio", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Current Liabilities"),
			 "Quick Ratio", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Current Liabilities"),
			 "Immediate Liquidity", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Current Liabilities"),
			 "DSCR", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Debt Service"),
			 "Development Margin", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "GDV"),
			 "Profit on Cost", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Current Investment"),
			 "ROI", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Current Investment"),
			 "LTC", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Current Investment"),
			 "LTV", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "GDV"),
			 "Collection Rate", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Contracted Sales"),
			 "% Sold", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "GDV"),
			 "Average Selling Price", CALCULATE([KPI Actual], REMOVEFILTERS('SIM_KPI'), 'SIM_KPI'[KPI ID] = "Units Sold"),
			 BLANK())
			VAR v_MapPending = CALCULATE([Balance Mapping Pending], REMOVEFILTERS('Dim_Date'), DATESBETWEEN('Dim_Date'[Date],[Context Start],[Context End]), TREATAS({v_Entity},'Dim_Company'[Company ID]))
			RETURN SWITCH(TRUE(),
			 v_Entity = "CON" && ISBLANK(v_Value), "PENDING RECONCILIATION",
			 ISBLANK(v_Entity), "SELECT ONE COMPANY",
			 v_Kind IN {"Project","Commercial"} && COUNTROWS(ALL('Dim_Project')) = 0, "SOURCE REQUIRED",
			 v_Kind IN {"Project","Commercial"} && NOT HASONEVALUE('Dim_Project'[Project ID]), "SELECT ONE PROJECT",
			 v_Id = "DSCR" && ISBLANK(v_Denominator), "SOURCE REQUIRED",
			 ISBLANK(v_Value) && NOT ISBLANK(v_Denominator) && v_Denominator = 0, "UNDEFINED — ZERO DENOMINATOR",
			 ISBLANK(v_Value) && v_MapPending > 0 && v_Id IN {"Current Assets","Current Liabilities","Working Capital","Current Ratio","Quick Ratio","Immediate Liquidity"}, "PENDING MAPPING",
			 ISBLANK(v_Value) && v_Id IN {"Net Result","Net Margin"}, "TAX SOURCE REQUIRED",
			 [KPI Coverage Missing], "INCOMPLETE PERIOD",
			 v_Id IN {"Collections","Commercial Receivables","Overdue Receivables","Expected Collections","Collection Rate"} && ISBLANK(v_Value), "COLLECTION COVERAGE REQUIRED",
			 ISBLANK(v_Value), "NO DATA",
			 ISBLANK(v_Target), "NO TARGET",
			 NOT (v_Direction IN {"Higher","Lower"}), "TARGET DIRECTION REQUIRED",
			 NOT ISBLANK(v_Limit) && IF(v_Direction = "Lower", v_Limit < v_Target, v_Limit > v_Target), "TARGET CONFIGURATION ERROR",
			 NOT ISBLANK(v_Excellent) && IF(v_Direction = "Lower", v_Excellent > v_Target, v_Excellent < v_Target), "TARGET CONFIGURATION ERROR",
			 NOT ISBLANK(v_Excellent) && IF(v_Direction = "Lower", v_Value <= v_Excellent, v_Value >= v_Excellent), "EXCELLENT",
			 IF(v_Direction = "Lower", v_Value <= v_Target, v_Value >= v_Target), "ON TARGET",
			 NOT ISBLANK(v_Limit) && IF(v_Direction = "Lower", v_Value > v_Limit, v_Value < v_Limit), "CRITICAL",
			 "ATTENTION")
		formatString: General
		lineageTag: e2d0e962-ada4-5399-8bdd-ca369af0016b
		displayFolder: SIM / KPI Engine

	measure 'Comparison Status' =
			VAR v_Mode = SELECTEDVALUE('SIM_Comparison'[Comparison], "Homologous Period")
			RETURN IF(ISBLANK([KPI Comparative]), SWITCH(v_Mode, "Budget", "NO BUDGET", "Target", "NO TARGET", "Forecast", "NO FORECAST", "Custom", "SELECT VALID CUSTOM DATES / NO DATA", "Same Period of Selected Year", "SELECT COMPARISON YEAR / NO DATA", "Previous Period", IF([Selected Periodicity]="YTD", "PREVIOUS PERIOD NOT DEFINED FOR YTD", "NO COMPARATIVE DATA"), "NO COMPARATIVE DATA"), "COMPARATIVE AVAILABLE")
		formatString: General
		lineageTag: 7a20f641-0e9d-5887-a58a-fbd8035c9daa
		displayFolder: SIM / KPI Engine

	measure 'Management Reading' =
			VAR v_Status = [KPI Status]
			VAR v_Id = SELECTEDVALUE('SIM_KPI'[KPI ID])
			VAR v_Delta = [KPI Variance]
			RETURN SWITCH(TRUE(), v_Status = "PENDING RECONCILIATION", "Eliminações intercompany e cobertura ainda não reconciliadas.", v_Status = "PENDING MAPPING", "Classificar contas 24–28 e maturidade da dívida; não interpretar subtotal como total.", v_Status = "TAX SOURCE REQUIRED", "Resultado antes de imposto disponível; imposto aprovado necessário para resultado líquido.", v_Status = "SOURCE REQUIRED", "Fonte operacional necessária; valores do handover não foram importados como fatos.", ISBLANK([KPI Actual]), "Ausência de dados ou componente obrigatório; não é zero.", v_Id IN {"DSO","DPO"}, "Indicador aproximado; não substitui aging por fatura.", v_Id IN {"Funding Gap","Peak Funding Gap"} && [KPI Actual] > 0, "Necessidade de financiamento com base nas fontes disponíveis.", ISBLANK(v_Delta), [Comparison Status] & " | " & v_Status, "Variação " & FORMAT([KPI Variance %],"0.0%;(0.0%)") & " | " & v_Status)
		formatString: General
		lineageTag: 6d4f430c-4c22-5b78-873e-ba4f7b2b89f9
		displayFolder: SIM / KPI Engine

