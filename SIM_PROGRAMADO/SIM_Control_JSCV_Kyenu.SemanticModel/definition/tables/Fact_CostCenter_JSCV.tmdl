	partition Fact_CostCenter_JSCV = m
		mode: import
		source =
				let
				    Fonte = RAW_JSCV_BCC,
				
				    // =========================================================
				    // FUNÇÃO PARA LER UM BCC
				    // Procura a tabela que contém "Centro/Conta"
				    // =========================================================
				    TransformarBCC = (Binario as binary) as table =>
				        let
				            WB = Excel.Workbook(Binario, null, true),
				
				            // Examinar cada objeto existente no workbook
				            ComCabecalhos = Table.AddColumn(
				                WB,
				                "_DadosPreparados",
				                each
				                    try
				                        Table.PromoteHeaders(
				                            [Data],
				                            [PromoteAllScalars = true]
				                        )
				                    otherwise
				                        null
				            ),
				
				            // Identificar o objeto que realmente contém o BCC
				            ComBCC = Table.AddColumn(
				                ComCabecalhos,
				                "_EhBCC",
				                each
				                    try
				                        List.Contains(
				                            Table.ColumnNames([_DadosPreparados]),
				                            "Centro/Conta"
				                        )
				                    otherwise
				                        false,
				                type logical
				            ),
				
				            ApenasBCC = Table.SelectRows(
				                ComBCC,
				                each [_EhBCC] = true
				            ),
				
				            Resultado =
				                if Table.RowCount(ApenasBCC) > 0
				                then ApenasBCC{0}[_DadosPreparados]
				                else #table(
				                    {
				                        "Tipo",
				                        "Centro/Conta",
				                        "Descrição",
				                        "Débito Per.",
				                        "Crédito Per.",
				                        "Saldo Per.",
				                        "Débito Acum.",
				                        "Crédito Acum.",
				                        "Saldo Acum."
				                    },
				                    {}
				                )
				        in
				            Resultado,
				
				    // =========================================================
				    // APLICAR AOS 33 FICHEIROS
				    // =========================================================
				    AdicionarDados = Table.AddColumn(
				        Fonte,
				        "Cost Center Data",
				        each TransformarBCC([Content]),
				        type table
				    ),
				
				    // =========================================================
				    // MANTER METADADOS
				    // =========================================================
				    ManterColunas = Table.SelectColumns(
				        AdicionarDados,
				        {
				            "Source File",
				            "Company ID",
				            "Source Type",
				            "Year",
				            "Month",
				            "Period ID",
				            "Period Date",
				            "Cost Center Data"
				        }
				    ),
				
				    // =========================================================
				    // EXPANDIR BCC
				    // =========================================================
				    ExpandirDados = Table.ExpandTableColumn(
				        ManterColunas,
				        "Cost Center Data",
				        {
				            "Tipo",
				            "Centro/Conta",
				            "Descrição",
				            "Débito Per.",
				            "Crédito Per.",
				            "Saldo Per.",
				            "Débito Acum.",
				            "Crédito Acum.",
				            "Saldo Acum."
				        },
				        {
				            "Record Type",
				            "Cost Center Account ID",
				            "Description",
				            "Debit Period",
				            "Credit Period",
				            "Balance Period",
				            "Debit YTD",
				            "Credit YTD",
				            "Balance YTD"
				        }
				    ),
				
				    // =========================================================
				    // REMOVER LINHAS VAZIAS
				    // =========================================================
				    RemoverVazios = Table.SelectRows(
				        ExpandirDados,
				        each
				            [Cost Center Account ID] <> null
				            or [Description] <> null
				    ),
				
				    // =========================================================
				    // TIPOS
				    // =========================================================
				    Tipos = Table.TransformColumnTypes(
				        RemoverVazios,
				        {
				            {"Source File", type text},
				            {"Company ID", type text},
				            {"Source Type", type text},
				            {"Year", Int64.Type},
				            {"Month", Int64.Type},
				            {"Period ID", Int64.Type},
				            {"Period Date", type date},
				
				            {"Record Type", type text},
				            {"Cost Center Account ID", type text},
				            {"Description", type text},
				
				            {"Debit Period", type number},
				            {"Credit Period", type number},
				            {"Balance Period", type number},
				
				            {"Debit YTD", type number},
				            {"Credit YTD", type number},
				            {"Balance YTD", type number}
				        }
				    ),
				
				    // =========================================================
				    // ORDENAÇÃO
				    // =========================================================
				    Ordenar = Table.Sort(
				        Tipos,
				        {
				            {"Period ID", Order.Ascending},
				            {"Cost Center Account ID", Order.Ascending}
				        }
				    )
				
				in
				    Ordenar

	annotation PBI_ResultType = Table

