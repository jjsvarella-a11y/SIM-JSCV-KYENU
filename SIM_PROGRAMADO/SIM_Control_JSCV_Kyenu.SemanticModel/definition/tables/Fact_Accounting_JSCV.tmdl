	partition Fact_Accounting_JSCV = m
		mode: import
		source =
				let
				    Fonte = RAW_JSCV_BG,
				
				    // Função para transformar UM BG
				    TransformarBG = (Binario as binary) as table =>
				        let
				            ExcelFonte = Excel.Workbook(Binario, null, true),
				
				            Folhas = Table.SelectRows(
				                ExcelFonte,
				                each [Kind] = "Sheet"
				            ),
				
				            Dados =
				                if Table.RowCount(Folhas) > 0
				                then Folhas{0}[Data]
				                else #table({}, {}),
				
				            Cabecalhos = Table.PromoteHeaders(
				                Dados,
				                [PromoteAllScalars = true]
				            )
				        in
				            Cabecalhos,
				
				    // Aplicar a função a CADA um dos 33 ficheiros
				    AdicionarDados = Table.AddColumn(
				        Fonte,
				        "Accounting Data",
				        each TransformarBG([Content]),
				        type table
				    ),
				
				    // Manter os metadados de cada ficheiro
				    ManterColunas = Table.SelectColumns(
				        AdicionarDados,
				        {
				            "Source File",
				            "Company ID",
				            "Source Type",
				            "Year",
				            "Month",
				            "Period ID",
				            "Period Date",
				            "Accounting Data"
				        }
				    ),
				
				    // Expandir cada BG mantendo Ano/Mês/Source File
				    ExpandirDados = Table.ExpandTableColumn(
				        ManterColunas,
				        "Accounting Data",
				        {
				            "Conta",
				            "Descrição",
				            "Débito (Per.)",
				            "Crédito (Per.)",
				            "Saldo (Per.)",
				            "Débito (Acum.)",
				            "Crédito (Acum.)",
				            "Saldo (Acum.)"
				        },
				        {
				            "Account ID",
				            "Account Name",
				            "Debit Period",
				            "Credit Period",
				            "Balance Period",
				            "Debit YTD",
				            "Credit YTD",
				            "Balance YTD"
				        }
				    ),
				
				    // Eliminar apenas linhas contabilísticas completamente vazias
				    RemoverVazios = Table.SelectRows(
				        ExpandirDados,
				        each [Account ID] <> null or [Account Name] <> null
				    ),
				
				    // Tipos
				    Tipos = Table.TransformColumnTypes(
				        RemoverVazios,
				        {
				            {"Source File", type text},
				            {"Company ID", type text},
				            {"Source Type", type text},
				            {"Year", Int64.Type},
				            {"Month", Int64.Type},
				            {"Period ID", Int64.Type},
				            {"Period Date", type date},
				            {"Account ID", type text},
				            {"Account Name", type text},
				            {"Debit Period", type number},
				            {"Credit Period", type number},
				            {"Balance Period", type number},
				            {"Debit YTD", type number},
				            {"Credit YTD", type number},
				            {"Balance YTD", type number}
				        }
				    ),
				
				    Ordenar = Table.Sort(
				        Tipos,
				        {
				            {"Period ID", Order.Ascending},
				            {"Account ID", Order.Ascending}
				        }
				    )
				
				in
				    Ordenar

	annotation PBI_ResultType = Table

