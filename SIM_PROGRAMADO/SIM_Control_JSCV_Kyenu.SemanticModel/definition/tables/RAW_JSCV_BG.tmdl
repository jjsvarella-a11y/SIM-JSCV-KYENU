	partition RAW_JSCV_BG = m
		mode: import
		source =
				let
				    Fonte = RAW_ACCOUNTING_FILES,
				
				    // Apenas ficheiros JSCV BG
				    JSCV_BG = Table.SelectRows(
				        Fonte,
				        each [Name] <> null
				            and Text.Contains(
				                Text.Upper(Text.From([Name])),
				                "JSCV_BG"
				            )
				    ),
				
				    // Nome original para rastreabilidade
				    SourceFile = Table.AddColumn(
				        JSCV_BG,
				        "Source File",
				        each [Name],
				        type text
				    ),
				
				    // Empresa
				    CompanyID = Table.AddColumn(
				        SourceFile,
				        "Company ID",
				        each "JSCV",
				        type text
				    ),
				
				    // Tipo de fonte
				    SourceType = Table.AddColumn(
				        CompanyID,
				        "Source Type",
				        each "BG",
				        type text
				    ),
				
				    // Retirar extensão .xlsx
				    FileBase = Table.AddColumn(
				        SourceType,
				        "_FileBase",
				        each Text.BeforeDelimiter(
				            Text.From([Name]),
				            ".xlsx"
				        ),
				        type text
				    ),
				
				    // Separar o nome em partes:
				    // JSCV_BG_2024_01 -> JSCV | BG | 2024 | 01
				    FileParts = Table.AddColumn(
				        FileBase,
				        "_Parts",
				        each Text.Split([_FileBase], "_")
				    ),
				
				    // Ano
				    Year = Table.AddColumn(
				        FileParts,
				        "Year",
				        each try Number.FromText([_Parts]{2}) otherwise null,
				        Int64.Type
				    ),
				
				    // Mês / período contabilístico
				    Month = Table.AddColumn(
				        Year,
				        "Month",
				        each try Number.FromText([_Parts]{3}) otherwise null,
				        Int64.Type
				    ),
				
				    // Apenas períodos mensais 01-12
				    MesesValidos = Table.SelectRows(
				        Month,
				        each [Year] <> null
				            and [Month] <> null
				            and [Month] >= 1
				            and [Month] <= 12
				    ),
				
				    // YYYYMM
				    PeriodID = Table.AddColumn(
				        MesesValidos,
				        "Period ID",
				        each [Year] * 100 + [Month],
				        Int64.Type
				    ),
				
				    // Último dia do mês
				    PeriodDate = Table.AddColumn(
				        PeriodID,
				        "Period Date",
				        each Date.EndOfMonth(
				            #date([Year], [Month], 1)
				        ),
				        type date
				    ),
				
				    // Eliminar apenas colunas auxiliares
				    LimparAuxiliares = Table.RemoveColumns(
				        PeriodDate,
				        {"_FileBase", "_Parts"}
				    ),
				
				    // Ordenação cronológica
				    Ordenar = Table.Sort(
				        LimparAuxiliares,
				        {
				            {"Year", Order.Ascending},
				            {"Month", Order.Ascending}
				        }
				    )
				
				in
				    Ordenar

	annotation PBI_ResultType = Table

